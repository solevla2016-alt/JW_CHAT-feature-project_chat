DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
# В продакшене: домен бэкенда, например jwchat-api.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.onrender.com,.vercel.app

DATABASE_HOST=localhost
DATABASE_USER=jwchat
DATABASE_PASSWORD=jwchat_secret
DATABASE_NAME=jwchat
DATABASE_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# В продакшене: адрес фронтенда, например https://jwchat.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# AI Assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-plus:free
AI_ASSISTANT_USERNAME=AI Assistant
